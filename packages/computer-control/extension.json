{
  "id": "buzzni.computer-control",
  "version": "0.4.0",
  "apiVersion": 3,
  "engines": {
    "saycode": "^1.3.0"
  },
  "entrypoint": "index.js",
  "permissions": [
    "localTools.inspect",
    "localTools.install",
    "localTools.control",
    "localBrowser.setup"
  ],
  "managedLocalTool": {
    "version": 1,
    "id": "buzzni.computer-control.driver",
    "toolVersion": "0.38.0",
    "platforms": {
      "darwin-x64": {
        "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.38.0/cua-driver-rs-0.38.0-darwin-x86_64.tar.gz",
        "sha256": "68721a916f2d9b20233a14623e0f663caf6130ba9018465a57a178120d96bc4e",
        "archiveRoot": "cua-driver-rs-0.38.0-darwin-x86_64",
        "executable": "CuaDriver.app/Contents/MacOS/cua-driver",
        "executableSha256": "b4d974a9c1c92a700cd7be7ede987aea4a1e6835e37039ce3d628b71bd5f0ca8",
        "existingExecutables": [
          "/Applications/CuaDriver.app/Contents/MacOS/cua-driver"
        ],
        "appBundle": "CuaDriver.app",
        "signingTeamId": "YCK386LBJ7"
      },
      "win32-x64": {
        "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.38.0/cua-driver-rs-0.38.0-windows-x86_64.zip",
        "sha256": "997f20114ad3db227a854e1e5a886234f76405b155f4af70605d4b7ca4a436a1",
        "archiveRoot": "cua-driver-rs-0.38.0-windows-x86_64",
        "executable": "cua-driver.exe",
        "executableSha256": "ffa58d88779ee219304b0c307f4cfa970fe822f830c6ecf9254eda5c29e22bf2",
        "existingExecutables": []
      },
      "darwin-arm64": {
        "url": "https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.38.0/cua-driver-rs-0.38.0-darwin-arm64.tar.gz",
        "sha256": "5f71191c082ca07c9dfc13b7c9a6eec60a82818c245a93534cc0eb7911471d72",
        "archiveRoot": "cua-driver-rs-0.38.0-darwin-arm64",
        "executable": "CuaDriver.app/Contents/MacOS/cua-driver",
        "executableSha256": "b4d974a9c1c92a700cd7be7ede987aea4a1e6835e37039ce3d628b71bd5f0ca8",
        "existingExecutables": [
          "/Applications/CuaDriver.app/Contents/MacOS/cua-driver"
        ],
        "appBundle": "CuaDriver.app",
        "signingTeamId": "YCK386LBJ7"
      }
    },
    "operations": {
      "version": {
        "permission": "inspect",
        "argv": [
          "--version"
        ]
      },
      "doctor": {
        "permission": "inspect",
        "argv": [
          "doctor",
          "--json"
        ]
      },
      "permissions": {
        "permission": "inspect",
        "argv": [
          "call",
          "check_permissions",
          "{{json}}"
        ],
        "payload": {
          "prompt": false
        },
        "inputs": {}
      },
      "status": {
        "permission": "inspect",
        "argv": [
          "status"
        ],
        "inputs": {}
      },
      "autostartStatus": {
        "permission": "inspect",
        "argv": [
          "autostart",
          "status"
        ],
        "inputs": {}
      },
      "autostartKick": {
        "permission": "control",
        "argv": [
          "autostart",
          "kick"
        ],
        "inputs": {}
      },
      "stop": {
        "permission": "control",
        "argv": [
          "stop"
        ],
        "inputs": {}
      },
      "permissionStatus": {
        "permission": "inspect",
        "argv": [
          "permissions",
          "status",
          "--json"
        ]
      },
      "grant": {
        "permission": "inspect",
        "argv": [
          "permissions",
          "grant"
        ]
      },
      "windows": {
        "permission": "control",
        "argv": [
          "call",
          "list_windows",
          "{{json}}"
        ],
        "payload": {
          "session": "{{session}}"
        },
        "inputs": {}
      },
      "snapshot": {
        "permission": "control",
        "argv": [
          "call",
          "get_window_state",
          "{{json}}"
        ],
        "payload": {
          "session": "{{session}}",
          "pid": "{{pid}}",
          "window_id": "{{windowId}}",
          "include_screenshot": false,
          "max_elements": 500,
          "tree_format": "both"
        },
        "inputs": {
          "pid": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          },
          "windowId": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          }
        }
      },
      "click": {
        "permission": "control",
        "argv": [
          "call",
          "click",
          "{{json}}"
        ],
        "payload": {
          "session": "{{session}}",
          "pid": "{{pid}}",
          "window_id": "{{windowId}}",
          "element_token": "{{elementToken}}",
          "delivery_mode": "background"
        },
        "inputs": {
          "pid": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          },
          "windowId": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          },
          "elementToken": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "typeText": {
        "permission": "control",
        "argv": [
          "call",
          "type_text",
          "{{json}}"
        ],
        "payload": {
          "session": "{{session}}",
          "pid": "{{pid}}",
          "window_id": "{{windowId}}",
          "element_token": "{{elementToken}}",
          "text": "{{text}}",
          "delivery_mode": "background"
        },
        "inputs": {
          "pid": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          },
          "windowId": {
            "type": "integer",
            "min": 1,
            "max": 2147483647
          },
          "elementToken": {
            "type": "string",
            "maxLength": 4096
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "endSession": {
        "permission": "control",
        "argv": [
          "call",
          "end_session",
          "{{json}}"
        ],
        "payload": {
          "session": "{{session}}"
        },
        "inputs": {}
      }
    },
    "background": {
      "argv": [
        "serve"
      ],
      "stopOperation": "stop"
    }
  },
  "activationEvents": [
    "onCommand:buzzni.computer-control.open",
    "onCommand:buzzni.computer-control.inspect",
    "onCommand:buzzni.computer-control.install",
    "onCommand:buzzni.computer-control.doctor",
    "onCommand:buzzni.computer-control.profiles",
    "onCommand:buzzni.computer-control.management",
    "onCommand:buzzni.computer-control.automate",
    "onCommand:buzzni.computer-control.pair",
    "onCommand:buzzni.computer-control.status",
    "onCommand:buzzni.computer-control.cancel",
    "onCommand:buzzni.computer-control.revoke"
  ],
  "contributes": {
    "commands": [
      {
        "id": "buzzni.computer-control.open",
        "title": "Open computer/browser setup",
        "panelId": "buzzni.computer-control.panel"
      },
      {
        "id": "buzzni.computer-control.inspect",
        "title": "Inspect computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.install",
        "title": "Install computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.doctor",
        "title": "Doctor computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.profiles",
        "title": "Profiles computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.management",
        "title": "Management computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.automate",
        "title": "Automate computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.pair",
        "title": "Pair computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.status",
        "title": "Status computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.cancel",
        "title": "Cancel computer/browser setup"
      },
      {
        "id": "buzzni.computer-control.revoke",
        "title": "Revoke computer/browser setup"
      }
    ],
    "panels": [
      {
        "id": "buzzni.computer-control.panel",
        "title": "Computer & browser",
        "entrypoint": "panel.html"
      }
    ],
    "machineActions": [
      {
        "id": "buzzni.computer-control.machine",
        "title": "Computer & browser",
        "command": "buzzni.computer-control.open",
        "when": {
          "online": true
        }
      }
    ]
  }
}
