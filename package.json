{
  "name": "saycode-extensions",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "package:fixture": "node packages/sdk/dist/cli.js pack examples/hello-world",
    "verify:project-templates": "node scripts/verify-project-templates.mjs",
    "publish:sdk": "node scripts/publish-sdk.mjs",
    "package:project-templates": "npm run --workspace @buzzni/saycode-extension-project-templates pack",
    "package:plugin-manager": "npm run --workspace @buzzni/saycode-extension-plugin-manager pack",
    "package:artifact-publisher": "npm run --workspace @buzzni/saycode-extension-artifact-publisher pack",
    "package:telegram": "npm run --workspace @buzzni/saycode-extension-telegram pack",
    "package:slack": "npm run --workspace @buzzni/saycode-extension-slack pack",
    "package:discord": "npm run --workspace @buzzni/saycode-extension-discord pack",
    "package:document-templates": "npm run --workspace @buzzni/saycode-extension-document-templates pack",
    "package:computer-control": "npm run --workspace @buzzni/saycode-extension-computer-control pack",
    "package:moai": "npm run --workspace @buzzni/saycode-extension-moai pack",
    "catalog:sign": "node scripts/sign-extension-catalog.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2"
  }
}
